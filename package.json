{
  "name": "mvd-train-ticket-system",
  "version": "2.0.0",
  "description": "Advanced Train Ticket Booking & Management System for Mata Vaishno Devi Public Charitable Trust Annual Pilgrimage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:node": "nodemon server.js",
    "dev:react": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:node\" \"npm run dev:react\"",
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build"
  },
  "keywords": [
    "train-ticket",
    "vaishno-devi",
    "firebase",
    "booking-system",
    "irctc-style"
  ],
  "author": "ArovenTech",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.7.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.9"
  }
}
